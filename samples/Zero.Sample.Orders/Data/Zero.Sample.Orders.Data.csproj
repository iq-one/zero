<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The context every module stores through, and the conventions applied to all of it. Names none of the entities: each module maps its own.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The metapackage: a module belongs to the module system, and IModule plus
         AddModules live there. -->
    <ProjectReference Include="../../../src/IQOne.Zero/IQOne.Zero.csproj" />
    <ProjectReference Include="../../../src/IQOne.Zero.Generators/IQOne.Zero.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/IQOne.Zero.Persistence.EntityFramework/IQOne.Zero.Persistence.EntityFramework.csproj" />
  </ItemGroup>

</Project>
