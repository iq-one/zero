<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Placing, paying for and expiring orders. It depends on the catalogue and on pricing, and that is where its position in the startup order comes from -- nothing states a number.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/IQOne.Zero.Generators/IQOne.Zero.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/Zero.Sample.Orders.Catalog.csproj" />
    <ProjectReference Include="../Pricing/Zero.Sample.Orders.Pricing.csproj" />
    <ProjectReference Include="../../../src/IQOne.Zero.BackgroundWork/IQOne.Zero.BackgroundWork.csproj" />
    <ProjectReference Include="../../../src/IQOne.Zero.Events/IQOne.Zero.Events.csproj" />
    <ProjectReference Include="../../../src/IQOne.Zero.Resilience/IQOne.Zero.Resilience.csproj" />
    <ProjectReference Include="../../../src/IQOne.Zero.Validation/IQOne.Zero.Validation.csproj" />
  </ItemGroup>

</Project>
