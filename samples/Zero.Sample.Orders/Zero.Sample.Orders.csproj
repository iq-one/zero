<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The generated module is worth reading; this puts it somewhere you can open. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup Label="Every Zero package, which is the point of this sample">
    <ProjectReference Include="../../src/IQOne.Zero/IQOne.Zero.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Authorization/IQOne.Zero.Authorization.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.BackgroundWork/IQOne.Zero.BackgroundWork.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Caching/IQOne.Zero.Caching.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Events/IQOne.Zero.Events.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Observability/IQOne.Zero.Observability.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Persistence/IQOne.Zero.Persistence.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Persistence.EntityFramework/IQOne.Zero.Persistence.EntityFramework.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Resilience/IQOne.Zero.Resilience.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Web/IQOne.Zero.Web.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Generators/IQOne.Zero.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Label="The engine is the application's choice, never the framework's">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Sqlite pulls a vulnerable SQLitePCLRaw; pinned explicitly because this repository
         leaves transitive pinning off. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.core" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" />
  </ItemGroup>

</Project>
