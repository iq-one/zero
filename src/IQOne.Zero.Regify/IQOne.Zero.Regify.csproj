<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Analyzer paketinde lib/ yoktur; cerceve uyumu analyzers/ yolundan gelir. -->
    <!-- Analyzer paketinde lib/ yoktur; icerik analyzers/ yolundan gelir. Paket analizi
         bunu bos paket sanir. -->
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeSymbols>false</IncludeSymbols>
    <Description>Zero's source generators and analyzers. Generates registration, dispatch and entity mappings at build time, and reports captive dependencies, leaked persistence providers and mismatched columns as compiler errors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Analyzer surum takibi (RS2008)">
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup Label="Analyzer olarak paketlenir; tuketicinin csproj'unda hicbir adim yoktur">
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
