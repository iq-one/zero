<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>In-process fan-out: an event, many subscribers, all of them awaited. Delivery is a generated table rather than runtime reflection, every subscriber runs even when one fails, and the caller is told which ones did what.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IQOne.Zero.Results/IQOne.Zero.Results.csproj" />
    <ProjectReference Include="../IQOne.Zero.Abstractions/IQOne.Zero.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
