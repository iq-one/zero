<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>Retry as a pipeline behaviour, driven by the Result a request returns rather than by an exception. A query is retried; a command only when it says it is idempotent; and only the error kinds that another attempt could actually change. Not a replacement for Polly at the dependency — this is the part Polly cannot see.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IQOne.Zero.Messaging/IQOne.Zero.Messaging.csproj" />
  </ItemGroup>
</Project>
