<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>Read-through caching as a pipeline behaviour. A query says it may be cached and states its own key and lifetime; nothing else is cached, no failure is ever stored, and a command invalidates by the same key it reads.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IQOne.Zero.Messaging/IQOne.Zero.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>
</Project>
