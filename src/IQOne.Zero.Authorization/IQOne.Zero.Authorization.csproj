<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>Authorization as a pipeline behaviour. A caller who may not make a request is refused before anything reads data, the rule that refuses them is a class that can be tested on its own, and a request that declares nothing is refused rather than allowed.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IQOne.Zero.Messaging/IQOne.Zero.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One line at startup when the application left ICurrentUser unregistered. Without
         it the omission is silent and every request is refused with no clue why. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
