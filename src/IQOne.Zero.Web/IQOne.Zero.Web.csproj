<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>Turns commands and queries into HTTP endpoints. Routes are declared on the request, endpoints are generated, and a failed result becomes a problem response without the handler knowing HTTP exists.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IQOne.Zero.Messaging/IQOne.Zero.Messaging.csproj" />
    <!-- Authorization is transport-independent and sits below this package. Referencing it
         is what lets a route attribute BE the authorization declaration, instead of the
         author writing the same policy twice and the two drifting apart. -->
    <ProjectReference Include="../IQOne.Zero.Authorization/IQOne.Zero.Authorization.csproj" />
  </ItemGroup>
</Project>
