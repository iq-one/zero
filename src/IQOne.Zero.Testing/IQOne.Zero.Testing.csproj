<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZeroTargetFrameworks)</TargetFrameworks>
    <Description>Everything a test needs to exercise an application built on Zero: assertions on Result whose failure messages name the actual errors, a harness that runs one handler through the real pipeline, a recording ISender, and a test application whose container validates scopes and registrations the way startup does. Depends on no test runner.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Validation drags in Messaging, Results and Abstractions; Core adds the module phase.
         Web is deliberately absent: it would pull ASP.NET into every test project, which is
         the same reason the metapackage leaves it out. -->
    <ProjectReference Include="../IQOne.Zero.Validation/IQOne.Zero.Validation.csproj" />
    <ProjectReference Include="../IQOne.Zero.Core/IQOne.Zero.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- For the in-memory IConfiguration a test application always has. Options bind from it
         exactly as they would from appsettings.json. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>
</Project>
