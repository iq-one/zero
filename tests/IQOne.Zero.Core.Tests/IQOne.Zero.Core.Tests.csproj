<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    The kernel's own tests reach for the web and messaging capabilities on purpose: the
    defect they pin is that AddModules never ran under an ASP.NET host, and nothing short of
    that host, those capabilities and a real HTTP call proves it fixed.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/IQOne.Zero.Core/IQOne.Zero.Core.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Messaging/IQOne.Zero.Messaging.csproj" />
    <ProjectReference Include="../../src/IQOne.Zero.Web/IQOne.Zero.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
</Project>
