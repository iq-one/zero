<Project>

  <PropertyGroup Label="Dil ve derleme disiplini">
    <!-- LTS'ten LTS'e. Cerceve net10'a ozgu hicbir API kullanmaz, bu yuzden net8
         hedeflemek erisilebilir kitleyi genisletirken hicbir sey feda ettirmez. -->
    <ZeroTargetFrameworks>net8.0;net10.0</ZeroTargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Kimlik">
    <ZeroRepositoryRoot>$(MSBuildThisFileDirectory)</ZeroRepositoryRoot>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- Sync-over-async ve yasak API'ler derleme hatasi. Framework kendi kuralina uyar. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Label="Yasak API listesi tum projelerde gecerli">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(ZeroRepositoryRoot)BannedSymbols.txt" />
  </ItemGroup>

  <Import Project="$(ZeroRepositoryRoot)build/Packaging.props"
          Condition="'$(IsPackable)' != 'false' AND $(MSBuildProjectDirectory.Contains('src'))" />

</Project>
