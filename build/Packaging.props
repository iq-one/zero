<Project>

  <!--
    Paket kimligi ve nuget.org meta verisi. src/ altindaki her proje bir pakettir;
    PackageId proje adiyla aynidir, bu yuzden hicbir projede tek tek yazilmaz.
  -->

  <PropertyGroup Label="Kimlik">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Authors>IQOne</Authors>
    <Company>IQOne</Company>
    <Product>Zero</Product>
    <Copyright>Copyright (c) IQOne</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md. The API will change before 1.0; pin the version.</PackageReleaseNotes>
    <PackageTags>zero;iqone;framework;aspnetcore;source-generator;analyzer;ai-agents</PackageTags>
    <PackageProjectUrl>https://iqone.solutions/zero</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iq-one/zero</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Surum">
    <!-- Tek kaynak: build/Version.props. CI, VersionSuffix'i buradan gecer. -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(Configuration)' != 'Release'">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Kaynak ve semboller">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>$(ZeroRepositoryRoot)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!--
    One icon for all of them. A static item, not one added in a target: pack resolves the
    icon before any target of ours runs, and adding it later fails with NU5046 saying the
    file is not in the package.

    Nineteen grey squares in a package list is nineteen packages nobody can tell apart.

    No licence FILE: PackageLicenseExpression above is what nuget.org reads, and it renders
    the licence properly without one. LICENSE stays in the repository, where people look.
  -->
  <ItemGroup>
    <None Include="$(ZeroRepositoryRoot)icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!--
    Her paketin testleri kendi ic tiplerini gorur. Bir tipi yalnizca test edilebilsin diye
    public yapmak, yayinlanan yuzeyi surdurmek zorunda oldugumuz seylerle sisirir.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

  <Import Project="$(ZeroRepositoryRoot)build/Rules.targets" />

</Project>
