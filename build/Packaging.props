<Project>

  <!--
    Paket kimligi ve nuget.org meta verisi. src/ altindaki her proje bir pakettir;
    PackageId proje adiyla aynidir, bu yuzden hicbir projede tek tek yazilmaz.
  -->

  <PropertyGroup Label="Kimlik">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Authors>IQOne</Authors>
    <Company>IQOne</Company>
    <Product>Zero</Product>
    <Copyright>Copyright (c) IQOne</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>zero;iqone;framework;aspnetcore;source-generator;analyzer;ai-agents</PackageTags>
    <PackageProjectUrl>https://iqone.solutions/zero</PackageProjectUrl>
    <RepositoryUrl>https://github.com/keremcanaktas/zero</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Surum">
    <!-- Tek kaynak: build/Version.props. CI, VersionSuffix'i buradan gecer. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' AND '$(Configuration)' != 'Release'">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Kaynak ve semboller">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>$(ZeroRepositoryRoot)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="$(ZeroRepositoryRoot)build/Rules.targets" />

</Project>
