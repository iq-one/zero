<Project>

  <!--
    ================= Zero kural ve yetenek paketleme sozlesmesi =================

    Zero'nun kurallarinin iki alicisi var: derleyici ve yapay zeka ajani. Analyzer'lar
    kurali derleme aninda uygular; buradaki dosyalar ayni kurali ajanin okuyabilecegi
    bicimde tasir.

    Ikisi de paketin ICINDE gider. Sebebi versiyonlamadir: framework 1.2'ye ciktiginda
    ajanin okudugu kural da 1.2 olur. Ayri bir repoda duran dokuman bu garantiyi veremez
    ve sessizce eskir.

    Sozlesme:
      src/<Paket>/rules/*.md        ->  <nupkg>/zero/rules/<Paket>/*.md
      src/<Paket>/zero/*.json       ->  <nupkg>/zero/
      src/<Paket>.Analyzers/        ->  <nupkg>/analyzers/dotnet/cs/

    Kural dosyalari ajana "yanlis yapma"yi, capability.json ise "bu zaten yazilmis"i
    ogretir. Bir ajanin sinir disina cikmasinin en yaygin sebebi inat degil, var olani
    bilmemektir.

    Tuketici tarafinda `zero rules init` bu dosyalari restore edilmis paketlerden okur.
    Kurallarin yerini MSBuild item'i olarak da acan bir buildTransitive/<Paket>.targets
    vardi; kaldirildi. Hicbir tuketicisi yoktu ve bozuk gidiyordu: CDATA icindeki
    $(MSBuildThisFileDirectory) yazma aninda genisliyordu, yani her paket yayinlayanin
    makinesindeki mutlak yolu tasiyordu. Kullanilmayan bir mekanizmayi duzeltmek yerine
    sildik.
  -->

  <PropertyGroup>
    <!-- Kural ve bildirim dosyalari lib/ disinda durur; bu yerlesim kasitlidir. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <!--
    Paket icerigi DEGERLENDIRME zamaninda bildirilir. Bir hedef icinden eklenen None
    item'lari NuGet dosyalari topladiktan sonra olusur ve pakete hic girmez.
  -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/rules/**/*.md"
          Pack="true"
          PackagePath="zero/rules/$(PackageId)/" />

    <None Include="$(MSBuildProjectDirectory)/zero/*.json"
          Pack="true"
          PackagePath="zero/" />

    <None Include="$(MSBuildProjectDirectory)/README.md"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')"
          Pack="true"
          PackagePath="/" />

    <None Include="$(ZeroRepositoryRoot)README.md"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md')"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>

  <!--
    ================= Yetenek analyzer'i sozlesmesi =================

    Bir yetenek, kurallarini uygulayan analyzer'i src/<Paket>.Analyzers/ altinda tutar.
    O proje kendi basina yayinlanmaz; bu paketin icine analyzer olarak konur. Boylece
    tuketici tek paket kurar ve kurali derleyicide gorur.

    Klasor varsa gerisi kendiliginden olur: yeni bir yetenek eklemek icin burada
    degistirilecek bir sey yoktur.
  -->
  <PropertyGroup>
    <ZeroAnalyzerProject>$(MSBuildProjectDirectory)/../$(PackageId).Analyzers/$(PackageId).Analyzers.csproj</ZeroAnalyzerProject>
    <ZeroAnalyzerAssembly>$(MSBuildProjectDirectory)/../$(PackageId).Analyzers/bin/$(Configuration)/netstandard2.0/$(PackageId).Analyzers.dll</ZeroAnalyzerAssembly>
    <ZeroHasAnalyzer Condition="Exists('$(ZeroAnalyzerProject)')">true</ZeroHasAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZeroHasAnalyzer)' == 'true'">
    <!-- Derleme sirasini garanti eder; kutuphane analyzer'in koduna basvurmaz. -->
    <ProjectReference Include="$(ZeroAnalyzerProject)"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <None Include="$(ZeroAnalyzerAssembly)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
